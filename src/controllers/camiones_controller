from database.config import SessionLocal
from models.maestros import Camion, Remolque

class CamionesController:
    # --- Gestión de Camiones ---
    @staticmethod
    def registrar_camion(placa: str, alias: str, marca: str, vencimiento_rcv=None, vencimiento_trimestre=None):
        db = SessionLocal()
        try:
            nuevo = Camion(
                placa=placa.upper(), 
                alias_identificador=alias, 
                marca=marca,
                vencimiento_rcv=vencimiento_rcv,
                vencimiento_trimestre=vencimiento_trimestre
            )
            db.add(nuevo)
            db.commit()
            return True, "Camión registrado con éxito."
        except Exception as e:
            db.rollback()
            return False, f"Error: {str(e)}"
        finally:
            db.close()

    @staticmethod
    def obtener_camiones():
        db = SessionLocal()
        try:
            return db.query(Camion).order_by(Camion.placa).all()
        finally:
            db.close()

    # --- Gestión de Remolques ---
    @staticmethod
    def registrar_remolque(placa: str, alias: str, vencimiento_rcv=None, vencimiento_trimestre=None):
        db = SessionLocal()
        try:
            nuevo = Remolque(
                placa=placa.upper(),
                alias_identificador=alias,
                vencimiento_rcv=vencimiento_rcv,
                vencimiento_trimestre=vencimiento_trimestre
            )
            db.add(nuevo)
            db.commit()
            return True, "Remolque registrado con éxito."
        except Exception as e:
            db.rollback()
            return False, f"Error: {str(e)}"
        finally:
            db.close()

    @staticmethod
    def obtener_remolques():
        db = SessionLocal()
        try:
            return db.query(Remolque).order_by(Remolque.placa).all()
        finally:
            db.close()