from database.config import SessionLocal
from models.maestros import Ruta
from decimal import Decimal

class RutasController:
    @staticmethod
    def registrar(descripcion: str, costo: float):
        db = SessionLocal()
        try:
            costo_val = Decimal(str(costo)) if costo else Decimal("0.00")
            nueva = Ruta(descripcion_trayecto=descripcion, costo_unitario_sugerido=costo_val)
            db.add(nueva)
            db.commit()
            return True, "Ruta guardada."
        except Exception as e:
            db.rollback()
            return False, f"Error: {str(e)}"
        finally:
            db.close()

    @staticmethod
    def obtener_todas():
        db = SessionLocal()
        try:
            return db.query(Ruta).order_by(Ruta.descripcion_trayecto).all()
        finally:
            db.close()