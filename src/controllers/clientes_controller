from database.config import SessionLocal
from models.maestros import Cliente

class ClientesController:
    @staticmethod
    def registrar(nombre: str, contacto: str):
        db = SessionLocal()
        try:
            nuevo = Cliente(nombre_cliente=nombre, contacto_principal=contacto)
            db.add(nuevo)
            db.commit()
            return True, "Cliente registrado."
        except Exception as e:
            db.rollback()
            return False, f"Error: {str(e)}"
        finally:
            db.close()

    @staticmethod
    def obtener_todos():
        db = SessionLocal()
        try:
            return db.query(Cliente).order_by(Cliente.nombre_cliente).all()
        finally:
            db.close()